{
  "manifest_version": 3,
  "name": "ClipSlicer 연결",
  "version": "1.2.0",
  "description": "브라우저에서 재생 중인 방송·영상을 내 PC 의 ClipSlicer 로 보내 녹화/다운로드합니다. 정보는 이 PC(127.0.0.1) 밖으로 나가지 않습니다.",
  "key": "",
  "permissions": [
    "webRequest",
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ClipSlicer 로 보내기",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icon32.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "32": "icon32.png",
    "128": "icon128.png"
  },
  "commands": {
    "clip": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "녹화 중인 이 탭의 방송에서 방금 지나간 장면 클립 (ClipSlicer)"
    }
  }
}